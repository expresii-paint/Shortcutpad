<?xml version="1.0" encoding="utf-8"?>
<!-- macOS / normal-network build: standard nuget.org restore.
     Copy over NuGet.config on the Mac (or delete NuGet.config). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
