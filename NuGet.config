<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet.exe on this Windows PC is denied outbound TCP, so restore uses a
     local folder feed populated by tools/fetch_nuget.py (see README).
     On macOS (which has network) use NuGet.config.macOS instead. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-feed" value="C:\Dev\Projects\ShortcutPad\local-feed" />
  </packageSources>
</configuration>
