{
  "columns": 5,
  "alwaysOnTop": true,
  "opacity": 1.0,
  "dock": "none",
  "x": 60,
  "y": 60,
  "resizable": true,
  "autoFlow": true,
  "buttonWidth": 100,
  "buttonHeight": 62,
  "width": 526,
  "height": 400,
  "buttons": [
    { "label": "Copy",       "keys": "ctrl+c",              "color": "#2d6cdf" },
    { "label": "Paste",      "keys": "ctrl+v",              "color": "#2d6cdf" },
    { "label": "Cut",        "keys": "ctrl+x" },
    { "label": "Undo",       "keys": "ctrl+z" },
    { "label": "Redo",       "keys": "ctrl+y" },
    { "label": "Save",       "keys": "ctrl+s" },
    { "label": "Select all", "keys": "ctrl+a" },
    { "label": "Find",       "keys": "ctrl+f" },
    { "label": "Enter",      "keys": "enter" },
    { "label": "Esc",        "keys": "esc" },
    { "label": "Tab",        "keys": "tab" },
    { "label": "Backspace",  "keys": "backspace" },
    { "label": "Home",       "keys": "home" },
    { "label": "End",        "keys": "end" },
    { "label": "Delete",     "keys": "delete" },
    { "label": "Task mgr",   "keys": "ctrl+shift+esc" },
    { "label": "Vol -",      "keys": "volume_down" },
    { "label": "Mute",       "keys": "volume_mute" },
    { "label": "Vol +",      "keys": "volume_up" },
    { "label": "Play/Pause", "keys": "media_play_pause" },
    { "label": "Next",       "keys": "media_next" },
    { "label": "Prev",       "keys": "media_prev" },
    { "label": "Desktop",    "keys": "win+d" },
    { "label": "Calc",       "run": "calc.exe" },
    { "label": "Hello",      "text": "hello from pad",      "color": "#2e9e5b" }
  ]
}
