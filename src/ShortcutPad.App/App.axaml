<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShortcutPad.App">
    <Application.Styles>
        <FluentTheme />

        <!-- Drop target while dragging a button row in the editor's list.
             Kept in step with ButtonEditorWindow.TargetClass. -->
        <Style Selector="ListBoxItem.reorder-target">
            <Setter Property="Background" Value="#332D6CDF" />
        </Style>
    </Application.Styles>
</Application>
